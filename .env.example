# ==============================================================================
# PYQVerse Single-Project Vercel Environment Configuration
# ==============================================================================
# The complete application (Vite React frontend + FastAPI backend) runs in ONE
# Vercel project on ONE domain. All variables below are configured in:
# Vercel Project Settings → Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER-SIDE RUNTIME VARIABLES (FastAPI Serverless Function - api/index.py)
# ------------------------------------------------------------------------------
# Sensitive: Injected ONLY into Python serverless runtime; NEVER bundled to client JS.

APP_ENV=production
APP_NAME="PYQVerse Backend Engine"

# MongoDB Atlas Database Connection (Managed Cloud Service)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=pyqverse_production
MONGODB_TIMEOUT_MS=5000

# JWT Authentication Security (Generate with: openssl rand -hex 32)
JWT_SECRET=YOUR_64_CHAR_HEX_SECRET_KEY_HERE
SESSION_SECRET=YOUR_FALLBACK_SESSION_SECRET_HERE
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DEMO_PERSONAS_ENABLED=false

# CORS Allowed Origins
# In single-project Vercel, requests are same-origin. Include custom domain if used.
FRONTEND_ORIGINS=["https://pyqverse.vercel.app","https://pyqverse.edu"]

# Google AI Studio / Gemini API (Primary AI Tutor)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash

# Groq API (High-Speed Llama Fallback)
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE
GROQ_MODEL=llama-3.3-70b-versatile
AI_DEFAULT_PROVIDER=gemini
AI_FALLBACK_ENABLED=true
AI_REQUEST_TIMEOUT=25
AI_MAX_RETRIES=2

# Cloudflare R2 S3-Compatible Object Storage (Question Paper Vault)
CLOUDFLARE_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID_HERE
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID_HERE
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY_HERE
R2_BUCKET_NAME=pyqverse-vault
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
R2_SIGNED_URL_EXPIRATION_SECONDS=900

# Google Apps Script Master Catalog Bridge
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/<DEPLOYMENT_ID>/exec
GOOGLE_APPS_SCRIPT_SHARED_SECRET=YOUR_SHARED_SECRET_HERE
GOOGLE_SHEETS_SYNC_TIMEOUT_SECONDS=30

# ------------------------------------------------------------------------------
# 2. CLIENT-SIDE BUNDLED VARIABLES (Vite Frontend - Public)
# ------------------------------------------------------------------------------
# Non-sensitive: Compiled into client JS.
# In single-project Vercel, VITE_API_URL can be omitted; defaults to same-origin /api/v1.
VITE_API_URL=
VITE_APP_URL=https://pyqverse.vercel.app

# ------------------------------------------------------------------------------
# 3. LOCAL DEVELOPMENT ONLY
# ------------------------------------------------------------------------------
FASTAPI_BACKEND_URL=http://127.0.0.1:8000
