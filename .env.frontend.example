# ==============================================================================
# PYQVerse Frontend Environment Configuration (Vercel / Client-Side)
# ==============================================================================
# CRITICAL SECURITY NOTE:
# Variables prefixed with VITE_* are compiled directly into public client JavaScript.
# NEVER put database URIs, JWT secrets, or cloud API keys in this file or on Vercel!
# ==============================================================================

# Authoritative FastAPI Backend Base URL
# - In local development: leave blank or set to /api/v1 (proxied via Vite / Express to localhost:8000)
# - In production on Vercel: set to your deployed backend origin (e.g., https://api.pyqverse.edu or https://pyqverse-backend.up.railway.app)
#   The client normalizes trailing slashes and ensures /api/v1 prefix is appended.
VITE_API_URL=https://api.pyqverse.edu

# Canonical frontend production URL
VITE_APP_URL=https://pyqverse.edu
