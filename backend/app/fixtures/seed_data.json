  "questions": [
    {
      "id": "q_phy_01",
      "paperId": "pap_jee_2024_s1",
      "paperTitle": "JEE Main 2024 Session 1 (27 Jan Morning Shift)",
      "examId": "ex_jee_main",
      "examName": "JEE Main (Engineering)",
      "subjectId": "sub_physics",
      "subjectName": "Physics",
      "topicId": "top_rotational",
      "topicName": "Rotational Dynamics & Moment of Inertia",
      "year": 2024,
      "questionNumber": 1,
      "questionText": "A solid sphere of mass M and radius R rolls without slipping down an inclined plane of inclination θ. What is the linear acceleration of the center of mass of the sphere along the incline?",
      "options": [
        {
          "key": "A",
          "text": "(5/7) g sin θ"
        },
        {
          "key": "B",
          "text": "(2/3) g sin θ"
        },
        {
          "key": "C",
          "text": "(5/9) g sin θ"
        },
        {
          "key": "D",
          "text": "(3/5) g sin θ"
        }
      ],
      "correctAnswer": "A",
      "marks": 4,
      "negativeMarks": 1,
      "difficulty": "Medium",
      "verifiedSolution": {
        "finalAnswer": "Option A: (5/7) g sin θ",
        "stepByStep": [
          "Equation of motion down the incline: M g sin θ - f = M a, where f is the friction force.",
          "Torque about center of mass: τ = f · R = I α = (2/5 M R²) · (a / R).",
          "Hence, friction force f = (2/5) M a.",
          "Substituting into linear equation: M g sin θ - (2/5) M a = M a.",
          "Therefore: (7/5) M a = M g sin θ ⇒ a = (5/7) g sin θ."
        ],
        "keyConcept": "Pure rolling constraint without slipping requires a = α R. Solid sphere moment of inertia is I = 2/5 M R².",
        "commonMistakes": "Students often forget the factor of 2/5 for a solid sphere and mistakenly use 1/2 (cylinder/disc) yielding 2/3 g sin θ."
      }
    },
    {
      "id": "q_phy_02",
      "paperId": "pap_jee_2024_s1",
      "paperTitle": "JEE Main 2024 Session 1 (27 Jan Morning Shift)",
      "examId": "ex_jee_main",
      "examName": "JEE Main (Engineering)",
      "subjectId": "sub_physics",
      "subjectName": "Physics",
      "topicId": "top_thermo",
      "topicName": "Thermodynamics & Carnot Cycles",
      "year": 2024,
      "questionNumber": 2,
      "questionText": "A Carnot engine operates with an efficiency of 40% when the temperature of the sink is 300 K. By how much must the temperature of the source be increased to raise its efficiency to 50%?",
      "options": [
        {
          "key": "A",
          "text": "100 K"
        },
        {
          "key": "B",
          "text": "50 K"
        },
        {
          "key": "C",
          "text": "150 K"
        },
        {
          "key": "D",
          "text": "75 K"
        }
      ],
      "correctAnswer": "A",
      "marks": 4,
      "negativeMarks": 1,
      "difficulty": "Easy",
      "verifiedSolution": {
        "finalAnswer": "Option A: 100 K",
        "stepByStep": [
          "Efficiency formula: η = 1 - (T_sink / T_source).",
          "Case 1: 0.40 = 1 - (300 / T_source_1) ⇒ 300 / T_source_1 = 0.60 ⇒ T_source_1 = 500 K.",
          "Case 2: To make η = 0.50 with same sink (300 K): 0.50 = 1 - (300 / T_source_2) ⇒ 300 / T_source_2 = 0.50 ⇒ T_source_2 = 600 K.",
          "Increase required in source temperature = T_source_2 - T_source_1 = 600 - 500 = 100 K."
        ],
        "keyConcept": "Carnot cycle efficiency depends strictly on absolute temperatures in Kelvin: η = 1 - T_L/T_H.",
        "commonMistakes": "Directly scaling temperature by percentages without converting to the reciprocal ratio."
      }
    },
    {
      "id": "q_chem_01",
      "paperId": "pap_jee_2024_s1",
      "paperTitle": "JEE Main 2024 Session 1 (27 Jan Morning Shift)",
      "examId": "ex_jee_main",
      "examName": "JEE Main (Engineering)",
      "subjectId": "sub_chem",
      "subjectName": "Chemistry",
      "topicId": "top_organic_mech",
      "topicName": "Aldehydes, Ketones & Nucleophilic Additions",
      "year": 2024,
      "questionNumber": 3,
      "questionText": "Which of the following compounds gives a positive iodoform test upon treatment with I₂ and aqueous NaOH?",
      "options": [
        {
          "key": "A",
          "text": "Pentan-3-one"
        },
        {
          "key": "B",
          "text": "Pentan-2-one"
        },
        {
          "key": "C",
          "text": "Benzophenone"
        },
        {
          "key": "D",
          "text": "Methanol"
        }
      ],
      "correctAnswer": "B",
      "marks": 4,
      "negativeMarks": 1,
      "difficulty": "Easy",
      "verifiedSolution": {
        "finalAnswer": "Option B: Pentan-2-one",
        "stepByStep": [
          "The haloform/iodoform reaction requires compounds containing the methyl carbonyl group (CH₃-C=O) or methyl carbinol group (CH₃-CH(OH)-).",
          "Pentan-3-one is CH₃-CH₂-CO-CH₂-CH₃ (no CH₃-CO group).",
          "Pentan-2-one is CH₃-CO-CH₂-CH₂-CH₃ (contains the essential CH₃-CO group).",
          "Hence, only Pentan-2-one forms the yellow precipitate of CHI₃."
        ],
        "keyConcept": "Iodoform reaction specifically tests for methyl ketones and secondary alcohols with a terminal methyl group.",
        "commonMistakes": "Confusing symmetrical ketones (like pentan-3-one) with 2-ones."
      }
    },
    {
      "id": "q_math_01",
      "paperId": "pap_jee_2024_s1",
      "paperTitle": "JEE Main 2024 Session 1 (27 Jan Morning Shift)",
      "examId": "ex_jee_main",
      "examName": "JEE Main (Engineering)",
      "subjectId": "sub_math",
      "subjectName": "Mathematics",
      "topicId": "top_definite_int",
      "topicName": "Definite Integrals & Area under Curves",
      "year": 2024,
      "questionNumber": 4,
      "questionText": "Evaluate the definite integral: I = ∫ [0 to π/2] (sin^3 x) / (sin^3 x + cos^3 x) dx.",
      "options": [
        {
          "key": "A",
          "text": "π / 2"
        },
        {
          "key": "B",
          "text": "π / 4"
        },
        {
          "key": "C",
          "text": "π / 8"
        },
        {
          "key": "D",
          "text": "1"
        }
      ],
      "correctAnswer": "B",
      "marks": 4,
      "negativeMarks": 1,
      "difficulty": "Medium",
      "verifiedSolution": {
        "finalAnswer": "Option B: π / 4",
        "stepByStep": [
          "Let I = ∫ [0 to π/2] (sin³ x) / (sin³ x + cos³ x) dx   --- (1)",
          "Applying property ∫ [0 to a] f(x) dx = ∫ [0 to a] f(a - x) dx:",
          "x → π/2 - x gives sin(π/2 - x) = cos x and cos(π/2 - x) = sin x.",
          "So I = ∫ [0 to π/2] (cos³ x) / (cos³ x + sin³ x) dx   --- (2)",
          "Adding (1) and (2): 2I = ∫ [0 to π/2] 1 dx = [x] from 0 to π/2 = π/2.",
          "Therefore, I = π / 4."
        ],
        "keyConcept": "Kings property of definite integrals: ∫ [0 to a] f(x) dx = ∫ [0 to a] f(a - x) dx simplifies symmetric trigonometric quotients.",
        "commonMistakes": "Trying to evaluate using powers of sin x or trigonometric substitutions instead of applying King's rule."
      }
    },
    {
      "id": "q_gate_01",
      "paperId": "pap_gate_cs_2024",
      "paperTitle": "GATE 2024 Computer Science & Information Technology",
      "examId": "ex_gate_cs",
      "examName": "GATE Computer Science & IT",
      "subjectId": "sub_gate_dsa",
      "subjectName": "Data Structures & Algorithms",
      "topicId": "top_graphs_tree",
      "topicName": "Binary Search Trees & AVL Balancing",
      "year": 2024,
      "questionNumber": 1,
      "questionText": "What is the maximum number of nodes in an AVL tree of height 4 (where height of an empty tree is -1, and single root node has height 0)?",
      "options": [
        {
          "key": "A",
          "text": "31"
        },
        {
          "key": "B",
          "text": "15"
        },
        {
          "key": "C",
          "text": "20"
        },
        {
          "key": "D",
          "text": "12"
        }
      ],
      "correctAnswer": "A",
      "marks": 1,
      "negativeMarks": 0.33,
      "difficulty": "Medium",
      "verifiedSolution": {
        "finalAnswer": "Option A: 31",
        "stepByStep": [
          "The maximum number of nodes in any binary tree of height h occurs when the tree is a complete/perfect binary tree.",
          "For a perfect binary tree of height h: N_max(h) = 2^(h+1) - 1.",
          "Given h = 4: N_max(4) = 2^(4+1) - 1 = 2^5 - 1 = 32 - 1 = 31.",
          "Since an AVL tree allows balance factor 0 (perfect balance), a perfect tree is also a valid AVL tree."
        ],
        "keyConcept": "Maximum nodes for an AVL tree is identical to a perfect binary tree: 2^(h+1) - 1. Minimum nodes follows the recurrence N(h) = N(h-1) + N(h-2) + 1.",
        "commonMistakes": "Confusing maximum nodes with minimum nodes (which would be Fibonacci based)."
      }
    },
    {
      "id": "q_gate_02",
      "paperId": "pap_gate_cs_2024",
      "paperTitle": "GATE 2024 Computer Science & Information Technology",
      "examId": "ex_gate_cs",
      "examName": "GATE Computer Science & IT",
      "subjectId": "sub_gate_os",
      "subjectName": "Operating Systems",
      "topicId": "top_concurrency",
      "topicName": "Process Synchronization & Peterson Algorithm",
      "year": 2024,
      "questionNumber": 2,
      "questionText": "Peterson's solution for mutual exclusion between two processes guarantees which of the following properties?",
      "options": [
        {
          "key": "A",
          "text": "Mutual Exclusion and Progress only"
        },
        {
          "key": "B",
          "text": "Mutual Exclusion and Bounded Waiting only"
        },
        {
          "key": "C",
          "text": "Mutual Exclusion, Progress, and Bounded Waiting"
        },
        {
          "key": "D",
          "text": "Hardware atomic execution without busy waiting"
        }
      ],
      "correctAnswer": "C",
      "marks": 2,
      "negativeMarks": 0.66,
      "difficulty": "Hard",
      "verifiedSolution": {
        "finalAnswer": "Option C: Mutual Exclusion, Progress, and Bounded Waiting",
        "stepByStep": [
          "Peterson's algorithm uses two shared variables: boolean flag[2] and int turn.",
          "1. Mutual Exclusion: At most one process can enter the critical section because (flag[j] && turn == j) cannot be false for both simultaneously.",
          "2. Progress: A process wishing to enter is not prevented by a non-competing process.",
          "3. Bounded Waiting: A process waits at most one entry by the rival process, satisfying bounded waiting."
        ],
        "keyConcept": "A correct critical-section solution must satisfy all three core requirements: Mutual Exclusion, Progress, and Bounded Waiting.",
        "commonMistakes": "Thinking Peterson's solution causes starvation; the turn variable guarantees bounded waiting."
      }
    }
