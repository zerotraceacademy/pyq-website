# ==============================================================================
# PYQVerse FastAPI Authoritative Backend Environment Configuration
# ==============================================================================

# Application Runtime
APP_ENV=production
APP_NAME="PYQVerse Backend Engine"
PORT=8000
HOST=0.0.0.0

# CORS Allowed Origins (Comma-separated or JSON list)
FRONTEND_ORIGINS=["https://pyqverse.vercel.app","https://pyqverse.edu","http://localhost:3000","http://localhost:5173"]

# Security & Authentication (Generate using: openssl rand -hex 32)
JWT_SECRET=YOUR_64_CHAR_HEX_SECRET_KEY_HERE
SESSION_SECRET=YOUR_FALLBACK_SESSION_SECRET_HERE
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DEMO_PERSONAS_ENABLED=false

# MongoDB Atlas Database
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=pyqverse_production
MONGODB_TIMEOUT_MS=5000

# Google Gemini API (Google AI Studio)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash

# Groq API (High-Speed Fallback)
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE
GROQ_MODEL=llama-3.3-70b-versatile
AI_DEFAULT_PROVIDER=gemini
AI_FALLBACK_ENABLED=true
AI_REQUEST_TIMEOUT=25
AI_MAX_RETRIES=2

# Cloudflare R2 S3-Compatible Object Storage
CLOUDFLARE_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID_HERE
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID_HERE
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY_HERE
R2_BUCKET_NAME=pyqverse-vault
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
R2_SIGNED_URL_EXPIRATION_SECONDS=900

# Google Apps Script Integration Bridge
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/<DEPLOYMENT_ID>/exec
GOOGLE_APPS_SCRIPT_SHARED_SECRET=YOUR_STRONG_SHARED_SECRET_HERE
GOOGLE_SHEETS_SYNC_TIMEOUT_SECONDS=30
